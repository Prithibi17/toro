rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function memberPath(companyId, uid) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(uid);
    }

    function isMember(companyId) {
      return isSignedIn()
        && exists(memberPath(companyId, request.auth.uid));
    }

    function isActiveMember(companyId) {
      return isMember(companyId)
        && get(memberPath(companyId, request.auth.uid)).data.status == "active";
    }

    function conversationAccess(companyId, channelId) {
      let channel = get(/databases/$(database)/documents/companies/$(companyId)/channels/$(channelId));
      return isActiveMember(companyId)
        && exists(/databases/$(database)/documents/companies/$(companyId)/channels/$(channelId))
        && (
          !channel.data.keys().hasAny(["type"])
          || channel.data.type == "public"
          || request.auth.uid in channel.data.memberIds
          || (
            channel.data.type == "department"
            && channel.data.departmentId in get(memberPath(companyId, request.auth.uid)).data.departmentIds
          )
        );
    }

    function callAccess(companyId, callId) {
      let call = get(/databases/$(database)/documents/companies/$(companyId)/calls/$(callId));
      return exists(/databases/$(database)/documents/companies/$(companyId)/calls/$(callId))
        && conversationAccess(companyId, call.data.conversationId);
    }

    function memberRole(companyId) {
      return get(
        memberPath(companyId, request.auth.uid)
      ).data.role;
    }

    function isCompanyOwner(companyId) {
      return isActiveMember(companyId)
        && memberRole(companyId) == "owner";
    }

    function isCompanyAdmin(companyId) {
      return isActiveMember(companyId)
        && memberRole(companyId) in ["owner", "admin"];
    }

    function hasEnabledModule(companyId, moduleName) {
      return isActiveMember(companyId)
        && moduleName in get(
          /databases/$(database)/documents/companies/$(companyId)
        ).data.enabledModules;
    }

    /*
     * Global user profiles
     */
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update: if isOwner(userId);
      allow delete: if false;

      /*
       * Workspace-discovery mirror.
       * Written only by trusted server code through Firebase Admin.
       */
      match /companyMemberships/{companyId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    /*
     * Company records
     */
    match /companies/{companyId} {
      allow read: if isActiveMember(companyId);

      /*
       * Company creation and sensitive changes must pass through
       * trusted server code using Firebase Admin.
       */
      allow create, update, delete: if false;

      /*
       * Authoritative company memberships
       */
      match /members/{userId} {
        allow read: if isActiveMember(companyId);
        allow create, update, delete: if false;
      }

      /*
       * Departments
       */
      match /departments/{departmentId} {
        allow read: if isActiveMember(companyId);
        allow create, update, delete: if isCompanyAdmin(companyId);
      }

      /*
       * Roles and permission templates
       */
      match /roles/{roleId} {
        allow read: if isActiveMember(companyId);
        allow create, update, delete: if isCompanyAdmin(companyId);
      }

      /*
       * Invitations are managed by trusted server operations.
       * Admins can read all invitations.
       * An invitee can read their own invitation (matched by email)
       * so the accept / decline UI can surface it.
       */
      match /invitations/{invitationId} {
        allow read: if isCompanyAdmin(companyId)
          || (isSignedIn() && resource.data.email == request.auth.token.email);
        allow create, update, delete: if false;
      }

      /*
       * Projects
       */
      match /projects/{projectId} {
        allow read: if isActiveMember(companyId);

        allow create: if isCompanyAdmin(companyId);

        allow update: if isCompanyAdmin(companyId)
          || (
            isActiveMember(companyId)
            && request.auth.uid in resource.data.memberIds
          );

        allow delete: if isCompanyAdmin(companyId);

        match /{subdocument=**} {
          allow read: if isActiveMember(companyId);
          allow write: if isCompanyAdmin(companyId);
        }
      }

      /*
       * Tasks
       */
      match /tasks/{taskId} {
        allow read: if isActiveMember(companyId)
          && (
            isCompanyAdmin(companyId)
            || request.auth.uid == resource.data.creatorId
            || request.auth.uid in resource.data.assigneeIds
            || request.auth.uid in resource.data.viewerIds
             || (
               memberRole(companyId) == "manager"
               && resource.data.keys().hasAny(["departmentIds"])
               && resource.data.departmentIds.hasAny(get(memberPath(companyId, request.auth.uid)).data.departmentIds)
             )
          );

        allow create: if isActiveMember(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.creatorId == request.auth.uid;

        allow update: if isCompanyAdmin(companyId)
          || (
            isActiveMember(companyId)
            && (
              request.auth.uid == resource.data.creatorId
              || request.auth.uid in resource.data.assigneeIds
            )
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.creatorId == resource.data.creatorId
          );

        allow delete: if isCompanyAdmin(companyId)
          || (
            isActiveMember(companyId)
            && request.auth.uid == resource.data.creatorId
          );

        match /comments/{commentId} {
          allow read: if isActiveMember(companyId);

          allow create: if conversationAccess(companyId, channelId)
            && request.resource.data.senderId == request.auth.uid;

          allow update, delete: if isActiveMember(companyId)
            && resource.data.senderId == request.auth.uid;
        }
      }

      /*
       * Discussions and channel messages
       */
      match /channels/{channelId} {
        allow read: if conversationAccess(companyId, channelId);

        allow create, update, delete: if isCompanyAdmin(companyId);

        match /messages/{messageId} {
          allow read: if conversationAccess(companyId, channelId);

          allow create: if isActiveMember(companyId)
            && request.resource.data.authorId == request.auth.uid;

          allow update, delete: if isActiveMember(companyId)
            && resource.data.authorId == request.auth.uid;
        }
      }

      /*
       * WebRTC calls (signaling via Firestore)
       * Subcollections: signals, offerCandidates, answerCandidates
       * update is required so peers can write their SDP answer into
       * an existing signal document.
       */
      match /calls/{callId} {
        allow read: if callAccess(companyId, callId);
        allow create, update, delete: if false;

        match /{candidateCollection}/{candidateId} {
          allow read, create, update: if callAccess(companyId, callId);
          allow delete: if false;
        }
      }

      /*
       * Calendar
       */
      match /calendarEvents/{eventId} {
        allow read: if isActiveMember(companyId);

        allow create: if isActiveMember(companyId)
          && request.resource.data.creatorId == request.auth.uid;

        allow update, delete: if isCompanyAdmin(companyId)
          || (
            isActiveMember(companyId)
            && resource.data.creatorId == request.auth.uid
          );
      }

      /*
       * Notifications
       */
      match /notifications/{notificationId} {
        allow read: if isActiveMember(companyId)
          && resource.data.recipientId == request.auth.uid;

        allow update: if isActiveMember(companyId)
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["read", "readAt"]);

        allow create, delete: if false;
      }

      /*
       * Administrative audit records are immutable from clients.
       */
      match /auditLogs/{auditId} {
        allow read: if isCompanyAdmin(companyId);
        allow create, update, delete: if false;
      }

      /*
       * Company configuration
       */
      match /settings/{settingId} {
        allow read: if isActiveMember(companyId);
        allow create, update, delete: if isCompanyAdmin(companyId);
      }

      /*
       * Business modules currently remain server-controlled.
       * Add narrower rules as each complete workflow is implemented.
       */
      match /contacts/{recordId} {
        allow read: if isActiveMember(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      match /crmDeals/{recordId} {
        allow read: if isActiveMember(companyId)
          && hasEnabledModule(companyId, "crm");
        allow write: if isCompanyAdmin(companyId)
          && hasEnabledModule(companyId, "crm");
      }

      match /crmLeads/{recordId} {
        allow read: if isActiveMember(companyId) && hasEnabledModule(companyId, "crm");
        allow write: if false;
      }
      match /crmContacts/{recordId} {
        allow read: if isActiveMember(companyId) && hasEnabledModule(companyId, "crm");
        allow write: if false;
      }
      match /crmOrganizations/{recordId} {
        allow read: if isActiveMember(companyId) && hasEnabledModule(companyId, "crm");
        allow write: if false;
      }
      match /crmOpportunities/{recordId} {
        allow read: if isActiveMember(companyId) && hasEnabledModule(companyId, "crm");
        allow write: if false;
      }
      match /crmPipelines/{recordId} {
        allow read: if isActiveMember(companyId) && hasEnabledModule(companyId, "crm");
        allow write: if false;
      }
      match /crmPipelineStages/{recordId} {
        allow read: if isActiveMember(companyId) && hasEnabledModule(companyId, "crm");
        allow write: if false;
      }
      match /crmActivities/{recordId} {
        allow read: if isActiveMember(companyId) && hasEnabledModule(companyId, "crm");
        allow write: if false;
      }

      match /salesOrders/{recordId} {
        allow read: if isActiveMember(companyId)
          && hasEnabledModule(companyId, "sales");
        allow write: if false;
      }

      match /invoices/{recordId} {
        allow read: if isCompanyAdmin(companyId)
          && hasEnabledModule(companyId, "accounting");
        allow write: if false;
      }

      match /products/{recordId} {
        allow read: if isActiveMember(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      match /warehouses/{recordId} {
        allow read: if isActiveMember(companyId)
          && hasEnabledModule(companyId, "inventory");
        allow write: if isCompanyAdmin(companyId)
          && hasEnabledModule(companyId, "inventory");
      }

      match /stockMovements/{recordId} {
        allow read: if isActiveMember(companyId)
          && hasEnabledModule(companyId, "inventory");
        allow write: if false;
      }

      match /purchaseOrders/{recordId} {
        allow read: if isActiveMember(companyId)
          && hasEnabledModule(companyId, "purchase");
        allow write: if false;
      }

      match /manufacturingOrders/{recordId} {
        allow read: if isActiveMember(companyId)
          && hasEnabledModule(companyId, "manufacturing");
        allow write: if false;
      }

      /*
       * Deny any company collection not explicitly listed above.
       */
      match /{document=**} {
        allow read, write: if false;
      }
    }

    /*
     * Deny everything outside the declared structure.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
